{
  "rabbit_version": "3.12.0",
  "rabbitmq_version": "3.12.0",
  "users": [
    {
      "name": "agrobridge",
      "password_hash": "agrobridge_password",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "agrobridge"
    }
  ],
  "permissions": [
    {
      "user": "agrobridge",
      "vhost": "agrobridge",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "parameters": [],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "agrobridge-cluster"
    }
  ],
  "policies": [
    {
      "vhost": "agrobridge",
      "name": "ha-all",
      "pattern": ".*",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all",
        "ha-sync-mode": "automatic"
      },
      "priority": 0
    },
    {
      "vhost": "agrobridge",
      "name": "dlx-policy",
      "pattern": "^(?!dlq\\.).*",
      "apply-to": "queues",
      "definition": {
        "dead-letter-exchange": "agrobridge.dlx",
        "message-ttl": 86400000
      },
      "priority": 1
    }
  ],
  "queues": [],
  "exchanges": [
    {
      "name": "agrobridge.default",
      "vhost": "agrobridge",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "agrobridge.events",
      "vhost": "agrobridge",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "agrobridge.dlx",
      "vhost": "agrobridge",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": []
}
