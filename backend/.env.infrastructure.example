# Database Infrastructure Configuration
# Copy this file to .env.infrastructure and update with your values

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=agrobridge_password_change_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# ============================================
# TimescaleDB Configuration
# ============================================
TIMESCALE_USER=agrobridge
TIMESCALE_PASSWORD=agrobridge_password_change_in_production
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://agrobridge:agrobridge_password_change_in_production@localhost:27017/
MONGODB_USER=agrobridge
MONGODB_PASSWORD=agrobridge_password_change_in_production
MONGODB_PORT=27017
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=20000

# ============================================
# Redis Configuration
# ============================================
REDIS_MODE=standalone  # Options: standalone, sentinel, cluster
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=agrobridge_redis_change_in_production
REDIS_MAX_CONNECTIONS=50
CACHE_TIMEOUT=300

# Redis Sentinel (for high availability)
REDIS_SENTINEL_HOSTS=localhost:26379
REDIS_MASTER_NAME=mymaster

# Redis Cluster (for horizontal scaling)
REDIS_CLUSTER_HOSTS=localhost:7000,localhost:7001,localhost:7002

# Django Channels
CHANNELS_CAPACITY=1000
CHANNELS_EXPIRY=60

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_PORT=9200

# ============================================
# Database Mode Selection
# ============================================
USE_SQLITE=false  # Set to true for development with SQLite
USE_REDIS=true    # Set to false for development with in-memory cache

# ============================================
# Backup Configuration
# ============================================
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_DIR=/backups
DB_BACKUP_COMPRESSION=gzip

# ============================================
# Development Tools (optional)
# ============================================
PGADMIN_EMAIL=admin@agrobridge.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
MONGO_EXPRESS_PORT=8081

REDIS_COMMANDER_PORT=8082
KIBANA_PORT=5601
