# Database Infrastructure Configuration
# Copy this file to .env.infrastructure and update with your values

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=agrobridge_password_change_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=600

# ============================================
# TimescaleDB Configuration
# ============================================
TIMESCALE_USER=agrobridge
TIMESCALE_PASSWORD=agrobridge_password_change_in_production
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URI=mongodb://agrobridge:agrobridge_password_change_in_production@localhost:27017/
MONGODB_USER=agrobridge
MONGODB_PASSWORD=agrobridge_password_change_in_production
MONGODB_PORT=27017
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=45000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=20000

# ============================================
# Redis Configuration
# ============================================
REDIS_MODE=standalone  # Options: standalone, sentinel, cluster
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=agrobridge_redis_change_in_production
REDIS_MAX_CONNECTIONS=50
CACHE_TIMEOUT=300

# Redis Sentinel (for high availability)
REDIS_SENTINEL_HOSTS=localhost:26379
REDIS_MASTER_NAME=mymaster

# Redis Cluster (for horizontal scaling)
REDIS_CLUSTER_HOSTS=localhost:7000,localhost:7001,localhost:7002

# Django Channels
CHANNELS_CAPACITY=1000
CHANNELS_EXPIRY=60

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=false
ELASTICSEARCH_CA_CERTS=
ELASTICSEARCH_TIMEOUT=30
ELASTICSEARCH_MAX_RETRIES=3
ELASTICSEARCH_PORT=9200

# ============================================
# Database Mode Selection
# ============================================
USE_SQLITE=false  # Set to true for development with SQLite
USE_REDIS=true    # Set to false for development with in-memory cache

# ============================================
# Backup Configuration
# ============================================
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_DIR=/backups
DB_BACKUP_COMPRESSION=gzip

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=agrobridge
RABBITMQ_PASSWORD=agrobridge_password_change_in_production
RABBITMQ_VHOST=agrobridge
RABBITMQ_POOL_SIZE=10
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=300

# ============================================
# Celery Configuration
# ============================================
CELERY_BROKER_URL=amqp://agrobridge:agrobridge_password_change_in_production@localhost:5672/agrobridge
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_REDIS_DB=1
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for synchronous execution in development
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# ============================================
# Kong API Gateway Configuration
# ============================================
KONG_PG_HOST=kong-database
KONG_PG_PORT=5432
KONG_PG_USER=kong
KONG_PG_PASSWORD=kong_password_change_in_production
KONG_PG_DATABASE=kong

# Kong Ports
KONG_PROXY_PORT=8000
KONG_PROXY_SSL_PORT=8443
KONG_ADMIN_PORT=8001
KONG_ADMIN_GUI_PORT=8002

# JWT Configuration for Kong
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=900  # 15 minutes
JWT_REFRESH_TOKEN_EXPIRY=604800  # 7 days

# Rate Limiting
RATE_LIMIT_ANONYMOUS_MINUTE=10
RATE_LIMIT_ANONYMOUS_HOUR=200
RATE_LIMIT_AUTHENTICATED_MINUTE=100
RATE_LIMIT_AUTHENTICATED_HOUR=2000

# ============================================
# Consul Service Discovery Configuration
# ============================================
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_HTTP_PORT=8500
CONSUL_DNS_PORT=8600
CONSUL_TOKEN=  # Optional ACL token for production
CONSUL_SCHEME=http  # Use https in production with TLS

# Service Configuration
SERVICE_VERSION=1.0.0
ENVIRONMENT=development  # Options: development, staging, production

# ============================================
# Vault Secrets Management Configuration
# ============================================
VAULT_ADDR=http://localhost:8200
VAULT_PORT=8200
VAULT_TOKEN=  # Root token or AppRole token
VAULT_NAMESPACE=  # Optional for Vault Enterprise
VAULT_MOUNT_POINT=secret  # KV secrets engine mount point

# ============================================
# Development Tools (optional)
# ============================================
PGADMIN_EMAIL=admin@agrobridge.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
MONGO_EXPRESS_PORT=8081

REDIS_COMMANDER_PORT=8082
KIBANA_PORT=5601
