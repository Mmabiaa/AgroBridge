# API Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# WebSocket Configuration
VITE_WEBSOCKET_URL=ws://localhost:8000/ws/
VITE_WS_URL=ws://localhost:8000/ws/

# External API Keys
VITE_WEATHERBIT_API_KEY=your_weatherbit_api_key_here
VITE_CHATBASE_API_KEY=your_chatbase_api_key_here
VITE_CHATBOT_ID=your_chatbot_id_here
VITE_FLOWISE_API_KEY=your_flowise_api_key_here
VITE_FLOWISE_API_URL=http://localhost:3000/api/v1/prediction/<your_flow_id>

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=AgroBridge
VITE_APP_VERSION=1.0.0

# Analytics (Optional)
VITE_GA_TRACKING_ID=
VITE_SENTRY_DSN=

# Payment (Optional)
VITE_PAYSTACK_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
